    { "id": "episode_artifact", "type": "episode_script", "produced_by": "episode", "review_policy": { "mode": "manual", "gate_spec_id": "script_review_gate" }, "required_for": [], "versioning": { "immutable": true, "compare_by": "hash" } }
  ],
  "provider_policy": { "default_provider": "mock-script-provider", "allowed_providers": ["mock-script-provider"], "required_credentials": [], "fallback_providers": [] },
  "layouts": { "dag": { "theme": { "x": 80, "y": 60, "stage": "主题" }, "outline": { "x": 320, "y": 60, "stage": "大纲" }, "episode": { "x": 560, "y": 60, "stage": "分集" } } },
